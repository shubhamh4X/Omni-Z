{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information about an authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth user ID." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's full display name." },
        "photoURL": { "type": "string", "description": "User's Google profile avatar photo URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "A chat conversation belonging to a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session ID." },
        "userId": { "type": "string", "description": "ID of the owner user." },
        "title": { "type": "string", "description": "Conversation title." },
        "createdAt": { "type": "number", "description": "Epoch timestamp." },
        "updatedAt": { "type": "number", "description": "Epoch timestamp." }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles restricted to the owner."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Conversations stored under the authenticated user."
    }
  }
}
