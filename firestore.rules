rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check collection for connection validation
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents - each user can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User chat sessions and conversations
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
